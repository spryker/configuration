<textarea id="setting-{{ setting.key }}"
          class="form-control config-input"
          rows="4"
          autocomplete="off"
          spellcheck="false"
          placeholder="{{ (setting.has_custom_value ? 'A secret value is stored. Enter a new value to replace it.' : 'Enter a secret value.') | trans }}"
          data-original-value=""
          data-has-custom-value="{{ setting.has_custom_value ? '1' : '0' }}"
          {% if isEditable is defined and not isEditable %}disabled{% endif %}></textarea>
